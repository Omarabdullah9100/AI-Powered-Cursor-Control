{
  "name": "aicursor",
  "version": "1.0.0",
  "description": "AI-aware cursor companion for macOS, Windows, and Linux. Hold a key, ask a question, and get an answer about whatever your cursor is pointing at.",
  "license": "MIT",
  "author": "Mario Simic",
  "homepage": "https://aipointer.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/talentsache/aipointer.git"
  },
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "bake-icons": "node scripts/bake-icons.cjs",
    "dist": "npm run build && electron-builder --mac --win --linux",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist:mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "release": "bash scripts/release-build.sh",
    "release:mac": "bash scripts/release-build.sh --mac",
    "release:mac:unsigned": "bash scripts/release-build.sh --mac --no-sign",
    "release:no-notarize": "bash scripts/release-build.sh --no-notarize",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "marked": "^18.0.3",
    "node-gyp-build": "^4.8.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "framer-motion": "^11.0.0",
    "postcss": "^8.4.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.6",
    "wait-on": "^7.2.0"
  }
}
